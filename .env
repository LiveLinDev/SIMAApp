# ── Django ────────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost,bellamama.duckdns.org

# Equipo activo: adrian usa localhost; erick usa DuckDNS.
SIMA_PC=erick
REMOTE_DUCKDNS_HOST=bellamama.duckdns.org
REMOTE_LOCAL_API_BASE=http://bellamama.duckdns.org:8000/v1
REMOTE_PROXY_TARGET_HOST=bellamama.duckdns.org
REMOTE_PROXY_TARGET_PORT=8000

# ── Anthropic Claude (opcional) ───────────────────────────────────────────────
# Si tienes API key real, ponla aquí. Si no, deja "local" y se usará Qwen.
ANTHROPIC_API_KEY=local
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Modelo local (Qwen via LM Studio / Ollama) ────────────────────────────────
LOCAL_API_BASE=http://127.0.0.1:8003/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen3-30b-endpoint

# ── Parámetros de generación local ────────────────────────────────────────────
LOCAL_ITEMS_REQUESTED=auto
LOCAL_GENERATION_TEMPERATURE=0.4
LOCAL_VERIFICATION_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=8000
# Palabras por chunk — ~2000 palabras genera ~20-25 ítems de calidad
# Clases largas (>2000 palabras) se dividen automáticamente y se mergean
LOCAL_CHUNK_WORDS=2000

# ── Verificación con fuentes web para Qwen ───────────────────────────────────
VERIFICATION_FETCH_SOURCES=True
VERIFICATION_SOURCE_URLS=
VERIFICATION_MAX_SOURCES=6
VERIFICATION_SOURCE_TIMEOUT=8
VERIFICATION_SOURCE_CHARS=2200

# Verificacion local: web | eduqg | hybrid
# EduQG no entrena ni modifica Qwen; solo aporta contexto al verificador.
VERIFICATION_DEFAULT_MODE=web
EDUQG_REFERENCE_PATH=F:\Agente\datasets\eduqg
EDUQG_SOURCE_CHARS=6000
EDUQG_TOP_K=5
EDUQG_MAX_RECORDS=6000
VERIFICATION_DYNAMIC_WEB_SEARCH=True
VERIFICATION_SEARCH_QUERIES=3
VERIFICATION_SEARCH_RESULTS=3

# ── Cola local de procesamiento ──────────────────────────────────────────────
LOCAL_TASK_QUEUE_MAXSIZE=20

# ── Whisper (transcripción local, siempre local independiente del backend IA) ─
# Opciones: tiny, base, small, medium, large
WHISPER_MODEL=base
