# =============================================================================
# SIMAApp — configuración de entorno
# Copia este archivo a .env y completa los valores marcados. .env NO se versiona.
# =============================================================================

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# ── Base de datos ────────────────────────────────────────────────────────────
# start-postgres.bat crea sima_platform en :5433.
DB_ENGINE=postgres
POSTGRES_DB=sima_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Alternativa rápida para desarrollo sin Postgres:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# O una sola URL (tiene prioridad sobre las variables anteriores):
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/sima_platform

# ── Backend de IA en la nube (backend "cloud") ───────────────────────────────
# Cualquier proveedor con API compatible con OpenAI Chat Completions funciona
# con CLOUD_API_BASE + CLOUD_API_KEY + CLOUD_MODEL. Con una clave real aquí, la
# nube pasa a ser el backend por defecto. Elige UN bloque y comenta el resto.
#
# CLOUD_PROVIDER solo se usa para la etiqueta en la interfaz y para elegir el
# SDK nativo de Anthropic; valores: deepseek | openai | gemini | qwen | groq |
# mistral | anthropic | openai_compatible (vacío = se detecta solo).

# Con CLOUD_PROVIDER definido, CLOUD_API_BASE y CLOUD_MODEL tienen valor por defecto:
# lo unico obligatorio es la clave. Comprueba todo con:  python manage.py check_ai --ping --mini
#
# Qwen (Alibaba Model Studio, region internacional/Singapur) — PERFIL ACTIVO
#   Clave: https://modelstudio.console.alibabacloud.com  →  API Keys. Cuenta internacional:
#   1 millon de tokens gratis por modelo durante 90 dias; despues 0,14 / 0,42 USD por millon (in/out).
#   Si tu cuenta es de China continental usa https://dashscope.aliyuncs.com/compatible-mode/v1
CLOUD_PROVIDER=qwen
CLOUD_API_BASE=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
CLOUD_API_KEY=sk-...
CLOUD_MODEL=qwen-flash
CLOUD_LABEL=Qwen

# DeepSeek — ojo: deepseek-chat y deepseek-reasoner se retiraron el 24-jul-2026.
# CLOUD_PROVIDER=deepseek
# CLOUD_API_BASE=https://api.deepseek.com
# CLOUD_API_KEY=sk-...
# CLOUD_MODEL=deepseek-v4-flash

# OpenAI
# CLOUD_PROVIDER=openai
# CLOUD_API_BASE=https://api.openai.com/v1
# CLOUD_API_KEY=sk-...
# CLOUD_MODEL=gpt-5-mini            # o gpt-5-nano (más barato)

# Google Gemini (endpoint compatible con OpenAI; no acepta max_tokens -> CLOUD_MAX_TOKENS=0)
# CLOUD_PROVIDER=gemini
# CLOUD_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai/
# CLOUD_API_KEY=AIza...
# CLOUD_MODEL=gemini-3.1-flash-lite  # o gemini-3-flash
# CLOUD_MAX_TOKENS=0

# Alibaba Qwen (Model Studio internacional; 1M tokens gratis por modelo los primeros 90 días)
# (Qwen esta arriba como perfil activo; alternativas de modelo: qwen-plus, qwen3.8-flash)

# Groq (modelos abiertos muy rápidos; confirma el id en console.groq.com/docs/models)
# CLOUD_PROVIDER=groq
# CLOUD_API_BASE=https://api.groq.com/openai/v1
# CLOUD_API_KEY=gsk_...
# CLOUD_MODEL=qwen/qwen3.8-27b        # mejor formato .mini que openai/gpt-oss-120b en pruebas (sep-2026)
# CLOUD_VERIFICATION_MODEL=openai/gpt-oss-120b   # Qwen no evalua en la verificacion (n=0); GPT-OSS si
#   Nivel gratuito sin tarjeta, pero con 8 000 tokens por minuto y un tope diario por modelo:
#   SIMA espera y reintenta ante 429 (CLOUD_RATE_LIMIT_RETRIES=5, CLOUD_RATE_LIMIT_MAX_WAIT=90),
#   asi que una clase tarda mas pero termina. Para no pasar los 8 000 tokens por peticion:
#   CLOUD_CHUNK_WORDS=1200  CLOUD_ITEMS_PER_CHUNK_MAX=12  VERIFICATION_CONTEXT_MAX_CHARS=8000
#   CLOUD_MAX_TOKENS=4000   CLOUD_TOKENS_PER_MINUTE=6000  (la cuota del modelo; SIMA espera antes de llamar)

# Mistral
# CLOUD_PROVIDER=mistral
# CLOUD_API_BASE=https://api.mistral.ai/v1
# CLOUD_API_KEY=...
# CLOUD_MODEL=mistral-small-latest

# Anthropic Claude (SDK nativo; requiere `pip install anthropic`)
# CLOUD_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# CLOUD_MODEL=claude-opus-5          # o claude-sonnet-5 / claude-haiku-4-5 para reducir costo

# Parámetros comunes del backend cloud
CLOUD_MAX_TOKENS=6000
CLOUD_API_TIMEOUT=120
CLOUD_GENERATION_TEMPERATURE=0.3
CLOUD_VERIFICATION_TEMPERATURE=0.2
# True  = el proveedor entrega el MINI final en una pasada y se OMITE la verificación factual.
# False = se ejecuta la verificación contra fuentes (web / eduqg / hybrid). Recomendado.
CLOUD_DIRECT_MINI=False
# Recargo en créditos por usar la nube (sobre el costo base de la clase)
CLOUD_BACKEND_SURCHARGE=15

# Alias heredados (siguen funcionando si no defines CLOUD_*): DEEPSEEK_API_KEY,
# DEEPSEEK_API_BASE, DEEPSEEK_MODEL, DEEPSEEK_MAX_TOKENS, DEEPSEEK_API_TIMEOUT,
# DEEPSEEK_GENERATION_TEMPERATURE, DEEPSEEK_VERIFICATION_TEMPERATURE, DEEPSEEK_DIRECT_MINI.

# ── Backend local (opcional; solo si hay hardware para Ollama / LM Studio) ───
# Cualquier servidor con API compatible con OpenAI. Con start-everything.bat el
# proxy-8003.js reexpone Ollama (:8001) en :8003 con timeouts largos.
# False si no hay modelo local (VPS, PC sin GPU): las etapas que piden IA local usan la nube
LOCAL_AI_ENABLED=True
LOCAL_API_BASE=http://127.0.0.1:8003/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:7b
PROXY_IA_PORT=8003
PROXY_IA_TARGET_HOST=127.0.0.1
PROXY_IA_TARGET_PORT=8001
PROXY_IA_TIMEOUT_MS=7200000
LOCAL_API_TIMEOUT=7200

# ── Parámetros de generación ─────────────────────────────────────────────────
LOCAL_ITEMS_REQUESTED=auto
LOCAL_MIN_ITEMS=5
LOCAL_MAX_ITEMS=150
LOCAL_ITEMS_PER_CHUNK_MAX=22
CLOUD_ITEMS_PER_CHUNK_MAX=32
LOCAL_GENERATION_TEMPERATURE=0.4
LOCAL_VERIFICATION_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=6000
LOCAL_TRANSCRIPT_REPAIR_CHUNK_WORDS=500
LOCAL_CHUNK_WORDS=2000
LOCAL_COHERENCE_MAX_ITEMS=60

# ── Verificación factual ─────────────────────────────────────────────────────
# Modo por defecto: web | eduqg | hybrid
VERIFICATION_DEFAULT_MODE=web
VERIFICATION_FETCH_SOURCES=True
VERIFICATION_SOURCE_URLS=
VERIFICATION_MAX_SOURCES=6
VERIFICATION_SOURCE_TIMEOUT=8
VERIFICATION_SOURCE_CHARS=2200
VERIFICATION_DYNAMIC_WEB_SEARCH=True
VERIFICATION_ACADEMIC_SEARCH=True
VERIFICATION_SEARCH_QUERIES=3
VERIFICATION_SEARCH_RESULTS=3
# Corpus EduQG (solo para los modos eduqg / hybrid). Vacío = desactivado.
EDUQG_REFERENCE_PATH=
EDUQG_SOURCE_CHARS=6000
EDUQG_TOP_K=5
EDUQG_MAX_RECORDS=6000

# ── Cola de procesamiento (en memoria, dentro del proceso Django) ────────────
LOCAL_TASK_QUEUE_MAXSIZE=100
LOCAL_TASK_WORKERS=1
# thread: los trabajos se procesan en hilos del proceso web (simple, un solo proceso).
# db: el web solo encola y un proceso aparte los procesa: `python manage.py run_worker`
SIMA_QUEUE_MODE=thread
# Maximo de trabajos en cola/procesando por usuario (evita agotar creditos y cola por error)
SIMA_MAX_PENDING_JOBS=3
# Reencolar trabajos huérfanos al arrancar: auto con runserver; 1/0 para forzar (gunicorn, etc.)
# SIMA_REQUEUE_ON_START=1

# ── Whisper (transcripción, siempre local) ───────────────────────────────────
# tiny | base | small | medium | large. "base" ya viene descargado en el equipo.
WHISPER_MODEL=base

# ── Proxy público (opcional; solo para exponer la app fuera de la red) ───────
# Host público con el que los scripts .bat imprimen la URL de acceso externo.
SIMA_PUBLIC_HOST=TU-HOST-PUBLICO
PROXY_PORT=25564
PROXY_TARGET_HOST=127.0.0.1
PROXY_TARGET_PORT=8002

# ── Correo: recordatorios de estudio (python manage.py send_study_reminders) ─
# Consola por defecto. Para SMTP: django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SIMA <no-reply@sima.local>
# URL publica para los enlaces del correo (sin barra final)
SIMA_SITE_URL=

# ── Produccion (DJANGO_DEBUG=0) ───────────────────────────────────────────────
# DJANGO_SECRET_KEY=genera-una-clave-larga-y-unica
# DJANGO_ALLOWED_HOSTS=sima.midominio.pe,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://sima.midominio.pe
# SECURE_SSL_REDIRECT=1        # solo con HTTPS delante
# BEHIND_PROXY=1               # si nginx/Caddy termina TLS y manda X-Forwarded-Proto
# SECURE_HSTS_SECONDS=31536000
# SIMA_LOG_LEVEL=INFO          # logs/sima.log (rotativo, 5 MB x 3)
