DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost,bellamama.duckdns.org

# Database
# Recommended for SIMA:
DB_ENGINE=postgresql
POSTGRES_DB=simaapp
POSTGRES_USER=simaapp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Local fallback for quick demos:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# PostgreSQL option B:
# DATABASE_URL=postgresql://simaapp:change-me@127.0.0.1:5432/simaapp

SIMA_PC=adrian
REMOTE_DUCKDNS_HOST=bellamama.duckdns.org
REMOTE_LOCAL_API_BASE=http://bellamama.duckdns.org:8001/v1
REMOTE_PROXY_TARGET_HOST=bellamama.duckdns.org
REMOTE_PROXY_TARGET_PORT=25564
PROXY_PORT=25564
PROXY_TARGET_HOST=127.0.0.1
PROXY_TARGET_PORT=8002
ANTHROPIC_API_KEY=local
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# Proxy opcional entre Django y el modelo local. Si usas node .\proxy-8003.js,
# apunta LOCAL_API_BASE a http://127.0.0.1:8003/v1.
PROXY_IA_PORT=8003
PROXY_IA_TARGET_HOST=127.0.0.1
PROXY_IA_TARGET_PORT=8001
PROXY_IA_TIMEOUT_MS=7200000

# Si usas start-everything.bat (recomendado), deja el proxy IA en 8003.
LOCAL_API_BASE=http://127.0.0.1:8003/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen3-30b-endpoint
CLOUD_BACKEND_SURCHARGE=15
LOCAL_ITEMS_REQUESTED=auto
LOCAL_MIN_ITEMS=5
LOCAL_MAX_ITEMS=150
LOCAL_ITEMS_PER_CHUNK_MAX=22
CLOUD_ITEMS_PER_CHUNK_MAX=32
LOCAL_GENERATION_TEMPERATURE=0.4
LOCAL_VERIFICATION_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=6000
LOCAL_API_TIMEOUT=7200
LOCAL_TRANSCRIPT_REPAIR_CHUNK_WORDS=500
LOCAL_CHUNK_WORDS=2000
VERIFICATION_FETCH_SOURCES=True
VERIFICATION_SOURCE_URLS=
VERIFICATION_MAX_SOURCES=6
VERIFICATION_SOURCE_TIMEOUT=8
VERIFICATION_SOURCE_CHARS=2200
VERIFICATION_DEFAULT_MODE=web
EDUQG_REFERENCE_PATH=
EDUQG_SOURCE_CHARS=6000
EDUQG_TOP_K=5
EDUQG_MAX_RECORDS=6000
VERIFICATION_DYNAMIC_WEB_SEARCH=True
VERIFICATION_SEARCH_QUERIES=3
VERIFICATION_SEARCH_RESULTS=3
LOCAL_TASK_QUEUE_MAXSIZE=100
LOCAL_TASK_WORKERS=1
LOCAL_COHERENCE_MAX_ITEMS=60
WHISPER_MODEL=base
