# =============================================================================
# SIMAApp — configuración de entorno
# Copia este archivo a .env y completa los valores marcados. .env NO se versiona.
# =============================================================================

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1,localhost

# ── Base de datos ────────────────────────────────────────────────────────────
# Producción / equipo: PostgreSQL. start-postgres.bat crea sima_platform en :5433.
DB_ENGINE=postgres
POSTGRES_DB=sima_platform
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
# Alternativa rápida para desarrollo sin Postgres:
# DB_ENGINE=sqlite
# SQLITE_NAME=db.sqlite3
# O una sola URL (tiene prioridad sobre las variables anteriores):
# DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5433/sima_platform

# ── Backend de IA en la nube: DeepSeek (recomendado) ─────────────────────────
# Con una clave real aquí, el backend por defecto pasa a ser la nube.
# La interfaz lo etiqueta "Claude" por compatibilidad histórica; el proveedor es DeepSeek.
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MAX_TOKENS=6000
DEEPSEEK_API_TIMEOUT=120
DEEPSEEK_GENERATION_TEMPERATURE=0.3
DEEPSEEK_VERIFICATION_TEMPERATURE=0.2
# True  = DeepSeek entrega el MINI final en una pasada y se OMITE la verificación factual.
# False = se ejecuta la verificación contra fuentes (web / eduqg / hybrid). Recomendado.
DEEPSEEK_DIRECT_MINI=False

# ── Anthropic Claude (opcional; requiere `pip install anthropic`) ─────────────
ANTHROPIC_API_KEY=local
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# ── Modelo local (opcional; solo si hay hardware para Ollama / LM Studio) ────
# Cualquier servidor con API compatible OpenAI. Con start-everything.bat el
# proxy-8003.js reexpone Ollama (:8001) en :8003 con timeouts largos.
LOCAL_API_BASE=http://127.0.0.1:8003/v1
LOCAL_API_KEY=local
LOCAL_MODEL=qwen2.5:7b
PROXY_IA_PORT=8003
PROXY_IA_TARGET_HOST=127.0.0.1
PROXY_IA_TARGET_PORT=8001
PROXY_IA_TIMEOUT_MS=7200000
LOCAL_API_TIMEOUT=7200
# Heredado: si SIMA_PC=erick, settings ignora LOCAL_API_BASE y usa REMOTE_LOCAL_API_BASE.
# Déjalo en "local" para que LOCAL_API_BASE mande.
SIMA_PC=local
REMOTE_DUCKDNS_HOST=
REMOTE_LOCAL_API_BASE=

# ── Parámetros de generación ─────────────────────────────────────────────────
CLOUD_BACKEND_SURCHARGE=15
LOCAL_ITEMS_REQUESTED=auto
LOCAL_MIN_ITEMS=5
LOCAL_MAX_ITEMS=150
LOCAL_ITEMS_PER_CHUNK_MAX=22
CLOUD_ITEMS_PER_CHUNK_MAX=32
LOCAL_GENERATION_TEMPERATURE=0.4
LOCAL_VERIFICATION_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=6000
LOCAL_TRANSCRIPT_REPAIR_CHUNK_WORDS=500
LOCAL_CHUNK_WORDS=2000
LOCAL_COHERENCE_MAX_ITEMS=60

# ── Verificación factual ─────────────────────────────────────────────────────
# Modo por defecto: web | eduqg | hybrid
VERIFICATION_DEFAULT_MODE=web
VERIFICATION_FETCH_SOURCES=True
VERIFICATION_SOURCE_URLS=
VERIFICATION_MAX_SOURCES=6
VERIFICATION_SOURCE_TIMEOUT=8
VERIFICATION_SOURCE_CHARS=2200
VERIFICATION_DYNAMIC_WEB_SEARCH=True
VERIFICATION_ACADEMIC_SEARCH=True
VERIFICATION_SEARCH_QUERIES=3
VERIFICATION_SEARCH_RESULTS=3
# Corpus EduQG (solo para los modos eduqg / hybrid). Vacío = desactivado.
EDUQG_REFERENCE_PATH=
EDUQG_SOURCE_CHARS=6000
EDUQG_TOP_K=5
EDUQG_MAX_RECORDS=6000

# ── Cola de procesamiento (en memoria, dentro del proceso Django) ────────────
LOCAL_TASK_QUEUE_MAXSIZE=100
LOCAL_TASK_WORKERS=1

# ── Whisper (transcripción, siempre local) ───────────────────────────────────
# tiny | base | small | medium | large. "base" ya viene descargado en el equipo.
WHISPER_MODEL=base

# ── Proxy público (opcional; solo para exponer la app fuera de la red) ───────
PROXY_PORT=25564
PROXY_TARGET_HOST=127.0.0.1
PROXY_TARGET_PORT=8002
REMOTE_PROXY_TARGET_HOST=
REMOTE_PROXY_TARGET_PORT=25564
