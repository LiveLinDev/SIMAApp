# =============================================================================
# SIMA — plantilla de .env para PRODUCCION (VPS Linux con Nginx + gunicorn)
#
# Uso:  cp deploy/env.production.example /srv/sima/app/.env
#       chmod 600 /srv/sima/app/.env && chown sima:sima /srv/sima/app/.env
#
# REGLAS DE FORMATO (el cargador de sima/settings.py es muy simple):
#  - Una variable por linea: NOMBRE=valor  (sin espacios alrededor del "=").
#  - Los comentarios SOLO en su propia linea. Un "# comentario" al final de una
#    linea se vuelve parte del valor y rompe la configuracion.
#  - No uses comillas salvo que el valor las necesite (se quitan al leer).
#  - Los valores de este archivo PISAN las variables de entorno del sistema
#    (incluidas las Environment= de systemd).
#  - Reemplaza todo lo que empiece por CAMBIAR_ y la palabra DOMINIO.
#    (deploy/bootstrap_vps.sh lo hace solo para la clave, la BD y el dominio.)
# =============================================================================

# ── Django ───────────────────────────────────────────────────────────────────
# Clave larga y aleatoria. Genera una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=CAMBIAR_SECRET_KEY
# 0 en produccion. Nunca True en un servidor publico.
DJANGO_DEBUG=0
# Dominio publico (o la IP del VPS en modo demo) + 127.0.0.1 para el health check local.
DJANGO_ALLOWED_HOSTS=DOMINIO,127.0.0.1,localhost
# Origen exacto con esquema. En modo demo solo-IP por HTTP usa http://IP_DEL_VPS
CSRF_TRUSTED_ORIGINS=https://DOMINIO
# Donde collectstatic deja los archivos que sirve Nginx (vacio = BASE_DIR/staticfiles).
DJANGO_STATIC_ROOT=/srv/sima/app/staticfiles

# ── HTTPS detras de Nginx ────────────────────────────────────────────────────
# 1 = confiar en la cabecera X-Forwarded-Proto que pone Nginx. Dejalo en 1 siempre
# que la app este detras de deploy/nginx/sima.conf (evita 403 de CSRF y bucles).
BEHIND_PROXY=1
# FASE 1 (solo HTTP, antes de certbot): deja estos cuatro en 0.
# FASE 2 (certificado emitido y https://DOMINIO funcionando): pon 1, 1, 1 y
# SECURE_HSTS_SECONDS=3600; tras unos dias sin problemas, 31536000.
SECURE_SSL_REDIRECT=0
SESSION_COOKIE_SECURE=0
CSRF_COOKIE_SECURE=0
SECURE_HSTS_SECONDS=0

# ── Base de datos (PostgreSQL local del VPS) ─────────────────────────────────
DB_ENGINE=postgres
POSTGRES_DB=sima
POSTGRES_USER=sima
POSTGRES_PASSWORD=CAMBIAR_DB_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Alternativa: una sola URL (tiene prioridad sobre las POSTGRES_*). Si la usas, la
# contrasena solo con letras, numeros, - y _ (la URL no se decodifica: %40 no sirve).
# DATABASE_URL=postgresql://sima:CAMBIAR_DB_PASSWORD@127.0.0.1:5432/sima
# Arquitectura objetivo en Azure (Flexible Server con acceso privado; exige SSL):
# DATABASE_URL=postgresql://sima_admin:CAMBIAR_CONTRASENA_PG@sima-pg.postgres.database.azure.com:5432/sima?sslmode=require
# Solo para desarrollo sin Postgres (NO en produccion):
# SQLITE_NAME=db.sqlite3

# ── Proveedor de IA en la nube: Groq ─────────────────────────────────────────
# Clave en https://console.groq.com/keys (empieza por gsk_).
CLOUD_PROVIDER=groq
CLOUD_API_BASE=https://api.groq.com/openai/v1
CLOUD_API_KEY=CAMBIAR_GROQ_API_KEY
# Modelo de generacion (mejor formato .mini en pruebas de sep-2026).
CLOUD_MODEL=qwen/qwen3.8-27b
# Modelo para verificacion/reparacion (Qwen no evalua en la verificacion; GPT-OSS si).
CLOUD_VERIFICATION_MODEL=openai/gpt-oss-120b
# Etiqueta visible en la interfaz (vacio = "Groq").
CLOUD_LABEL=Groq
# Esfuerzo de razonamiento de los modelos gpt-oss: low | medium | high.
CLOUD_REASONING_EFFORT=low
# Limites pensados para el nivel gratuito de Groq (8 000 tokens por minuto/peticion).
CLOUD_MAX_TOKENS=4000
CLOUD_TOKENS_PER_MINUTE=6000
CLOUD_CHUNK_WORDS=1200
CLOUD_ITEMS_PER_CHUNK_MAX=12
VERIFICATION_CONTEXT_MAX_CHARS=8000
# Segundos por llamada, reintentos ante 429 y espera maxima entre reintentos.
CLOUD_API_TIMEOUT=120
CLOUD_RATE_LIMIT_RETRIES=5
CLOUD_RATE_LIMIT_MAX_WAIT=90
CLOUD_GENERATION_TEMPERATURE=0.3
CLOUD_VERIFICATION_TEMPERATURE=0.2
# False = se ejecuta la verificacion factual contra fuentes (recomendado).
CLOUD_DIRECT_MINI=False
# Recargo en creditos por usar la nube.
CLOUD_BACKEND_SURCHARGE=15
# Solo si usas Anthropic en vez de Groq (CLOUD_PROVIDER=anthropic):
# ANTHROPIC_API_KEY=CAMBIAR_ANTHROPIC_API_KEY
# ANTHROPIC_MODEL=claude-opus-5
# Alias heredados (no hacen falta con CLOUD_*): DEEPSEEK_API_KEY, DEEPSEEK_API_BASE,
# DEEPSEEK_MODEL, DEEPSEEK_MAX_TOKENS, DEEPSEEK_API_TIMEOUT,
# DEEPSEEK_GENERATION_TEMPERATURE, DEEPSEEK_VERIFICATION_TEMPERATURE, DEEPSEEK_DIRECT_MINI

# ── Modelo local (Ollama / LM Studio): NO existe en el VPS ───────────────────
# False = no hay servidor de IA local; las etapas que antes forzaban "local"
# (reparar transcripcion, coherencia) usan el proveedor en la nube de arriba.
LOCAL_AI_ENABLED=False
# Solo tienen efecto con LOCAL_AI_ENABLED=True; se dejan con valores seguros.
LOCAL_API_BASE=http://127.0.0.1:8003/v1
LOCAL_API_KEY=local
LOCAL_MODEL=
LOCAL_API_TIMEOUT=600

# ── Parametros de generacion ─────────────────────────────────────────────────
LOCAL_ITEMS_REQUESTED=auto
LOCAL_MIN_ITEMS=5
LOCAL_MAX_ITEMS=150
LOCAL_ITEMS_PER_CHUNK_MAX=22
LOCAL_GENERATION_TEMPERATURE=0.4
LOCAL_VERIFICATION_TEMPERATURE=0.3
LOCAL_MAX_TOKENS=6000
LOCAL_TRANSCRIPT_REPAIR_CHUNK_WORDS=500
LOCAL_CHUNK_WORDS=2000
LOCAL_COHERENCE_MAX_ITEMS=60

# ── Verificacion factual ─────────────────────────────────────────────────────
# Modo por defecto: web | eduqg | hybrid
VERIFICATION_DEFAULT_MODE=web
VERIFICATION_FETCH_SOURCES=True
VERIFICATION_SOURCE_URLS=
VERIFICATION_MAX_SOURCES=6
VERIFICATION_SOURCE_TIMEOUT=8
VERIFICATION_SOURCE_CHARS=2200
VERIFICATION_DYNAMIC_WEB_SEARCH=True
VERIFICATION_ACADEMIC_SEARCH=True
VERIFICATION_SEARCH_QUERIES=3
VERIFICATION_SEARCH_RESULTS=3
# Corpus EduQG (solo modos eduqg / hybrid). Vacio = desactivado.
EDUQG_REFERENCE_PATH=
EDUQG_SOURCE_CHARS=6000
EDUQG_TOP_K=5
EDUQG_MAX_RECORDS=6000

# ── Cola de trabajos ─────────────────────────────────────────────────────────
# db = el web solo encola; el servicio sima-worker (manage.py run_worker) procesa.
# Con gunicorn (varios procesos) NO uses "thread".
SIMA_QUEUE_MODE=db
# Maximo de trabajos en cola/procesando por usuario.
SIMA_MAX_PENDING_JOBS=2
# Solo aplica al modo thread; con db el worker reencola lo atascado.
SIMA_REQUEUE_ON_START=0
# Solo aplican al modo thread (se dejan por completitud).
LOCAL_TASK_QUEUE_MAXSIZE=100
LOCAL_TASK_WORKERS=1

# ── Whisper (transcripcion de audio en el propio VPS) ────────────────────────
# tiny (~1 GB RAM) | base (~1-1,5 GB) | small (~2-3 GB). Con 4 GB de RAM: base o tiny.
WHISPER_MODEL=tiny
# Transcripcion: remote = la PC del equipo transcribe con `manage.py serve_whisper` y el VPS la alcanza por un
# tunel SSH inverso en 127.0.0.1:9000 (el VPS no carga Whisper). local = Whisper en este servidor.
TRANSCRIPTION_BACKEND=remote
WHISPER_REMOTE_URL=http://127.0.0.1:9000
# Mismo valor que WHISPER_REMOTE_TOKEN en el .env de la PC
WHISPER_REMOTE_TOKEN=CAMBIAR_WHISPER_REMOTE_TOKEN
WHISPER_REMOTE_TIMEOUT=3600
# Respaldo si la PC no responde: vacio (la clase queda en error y se reintenta), local o cloud (envia el audio a Groq)
TRANSCRIPTION_FALLBACK=
CLOUD_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# ── Correo: recordatorios de estudio (sima-reminders.timer) ──────────────────
# Sin SMTP deja el backend de consola (los correos solo salen en el journal).
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Con SMTP real (ej. Gmail con "contrasena de aplicacion", Brevo, Mailjet):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=SIMA <no-reply@DOMINIO>
# URL publica para los enlaces de los correos, sin barra final.
SIMA_SITE_URL=https://DOMINIO

# ── Logs ─────────────────────────────────────────────────────────────────────
# logs/sima.log dentro de /srv/sima/app (rotativo, 5 MB x 3). DEBUG | INFO | WARNING
SIMA_LOG_LEVEL=INFO

# ── Solo para los .bat de Windows (la app en Linux no los usa) ───────────────
# SIMA_PUBLIC_HOST=DOMINIO
