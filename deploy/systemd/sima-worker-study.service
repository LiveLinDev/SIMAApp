# SIMA — worker de ESTUDIO en segundo plano (SIMA_QUEUE_MODE=db).
# Procesa resumenes y refuerzos. Las clases van en sima-worker.service.
#
# Instalar:  sudo cp deploy/systemd/sima-worker-study.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now sima-worker-study
# Logs:      journalctl -u sima-worker-study -f     (y /srv/sima/app/logs/sima.log)
#
# Ojo: reiniciar el worker mientras procesa corta ese trabajo; queda en
# PROCESSING y el propio worker lo reencola al arrancar si lleva mas de
# --stale-minutes sin actividad (ver PLAN_DESPLIEGUE_VPS.md, seccion 13).

[Unit]
Description=SIMA worker de estudio (manage.py run_worker --kinds summary,reinforcement)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sima
Group=sima
WorkingDirectory=/srv/sima/app
Environment=DJANGO_SETTINGS_MODULE=sima.settings
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/srv/sima
ExecStart=/srv/sima/venv/bin/python manage.py run_worker --kinds summary,reinforcement --interval 3 --stale-minutes 60
Restart=always
RestartSec=10
# SIGINT = Ctrl+C: run_worker lo captura y termina de forma ordenada.
KillSignal=SIGINT
TimeoutStopSec=60
# Resumenes y refuerzos solo llaman al proveedor de IA: consumen poca memoria.
MemoryHigh=300M
MemoryMax=450M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
