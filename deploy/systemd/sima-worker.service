# SIMA — worker de trabajos en segundo plano (SIMA_QUEUE_MODE=db).
# Procesa clases (Whisper + IA), refuerzos y resumenes que el web deja en cola.
#
# Instalar:  sudo cp deploy/systemd/sima-worker.service /etc/systemd/system/
#            sudo systemctl daemon-reload && sudo systemctl enable --now sima-worker
# Logs:      journalctl -u sima-worker -f     (y /srv/sima/app/logs/sima.log)
#
# Ojo: reiniciar el worker mientras procesa corta ese trabajo; queda en
# PROCESSING y el propio worker lo reencola al arrancar si lleva mas de
# --stale-minutes sin actividad (ver PLAN_DESPLIEGUE_VPS.md, seccion 13).

[Unit]
Description=SIMA worker (manage.py run_worker)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=sima
Group=sima
WorkingDirectory=/srv/sima/app
Environment=DJANGO_SETTINGS_MODULE=sima.settings
Environment=PYTHONUNBUFFERED=1
# HOME: Whisper guarda sus modelos en ~/.cache/whisper
Environment=HOME=/srv/sima
ExecStart=/srv/sima/venv/bin/python manage.py run_worker --interval 3 --stale-minutes 120
Restart=always
RestartSec=10
# SIGINT = Ctrl+C: run_worker lo captura y termina de forma ordenada.
KillSignal=SIGINT
TimeoutStopSec=60
# Si Whisper se come la RAM, que muera el worker y no el resto del VPS.
# Ajusta al tamano de tu VPS: 2 GB de RAM -> 1400M (con swap de 4 GB); 4 GB de RAM -> 2500M.
MemoryMax=1400M
OOMScoreAdjust=500
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
