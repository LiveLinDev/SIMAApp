    <element xsi:type="archimate:ArchimateDiagramModel" name="6. Arquitectura lógica de SIMA" id="id-9b096f3277605f80a039206c">
      <documentation>Arquitectura lógica en cuatro capas (presentación, aplicación, dominio, infraestructura) según la convención de la UPC; cada caja corresponde a un módulo real del repositorio SIMAApp.</documentation>
      <child xsi:type="archimate:Group" id="id-15a926383b2a5e18803b5bf8" name="Actores" fillColor="#f2f2f2" textAlignment="1">
        <bounds x="20" y="20" width="1379" height="121"/>
        <sourceConnection xsi:type="archimate:DiagramModelConnection" id="id-d05351e986bc50589a53dd7a" source="id-15a926383b2a5e18803b5bf8" target="id-f97c67d57e2f598a83bd6b0b" name="usa por HTTPS"/>
        <child xsi:type="archimate:DiagramObject" id="id-1990202fc42c5efabdf16cd5" archimateElement="id-18283a62140d58e2a8943652">
