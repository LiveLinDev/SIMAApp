<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="SIMA" id="id-e8ece293cf5e54cba82a1eba" version="5.0.0">
  <folder name="Strategy" id="id-84469465e2895c19bd7b689f" type="strategy"/>
  <folder name="Motivation" id="id-ed046316835e5a659e570ffa" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Estudiante universitario" id="id-8cc5383fd8ed5ff4a8e3c1dd"/>
    <element xsi:type="archimate:Stakeholder" name="Docente del curso" id="id-0df301ab67105a0d87530c0c"/>
    <element xsi:type="archimate:Goal" name="Mejorar la retención y el rendimiento en el curso" id="id-f21f585132865ccea41be336"/>
    <element xsi:type="archimate:Goal" name="Ítems de evaluación fiables generados con modelos de lenguaje" id="id-b6020ec3c0045992bee61778"/>
    <element xsi:type="archimate:Requirement" name="Salida del modelo parseable, compacta y verificable (notación .mini)" id="id-6df02ee3280456c087eefb65"/>
    <element xsi:type="archimate:Requirement" name="Evaluación adaptativa con memoria del estudiante (IRT 3PL)" id="id-fcfd6965a2965ad699c7f247"/>
    <element xsi:type="archimate:Requirement" name="Verificación factual contra fuentes antes de persistir" id="id-1415afecb9d15516b956adc2"/>
    <element xsi:type="archimate:Principle" name="Transcripción local: el audio no sale del servidor" id="id-854a091d4ef15134bf11db18"/>
  </folder>
  <folder name="Business" id="id-52d0c27dea1a59d58b19e45f" type="business">
    <element xsi:type="archimate:BusinessActor" name="Estudiante" id="id-18283a62140d58e2a8943652">
      <documentation>Sube clases, practica, repasa, genera refuerzo y resúmenes, revisa su progreso.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Docente" id="id-eda1f8dc41205f19a88fcd8c">
      <documentation>Fuente de las grabaciones; juez de calidad de los ítems en la validación.</documentation>
    </element>
    <element xsi:type="archimate:BusinessActor" name="Administrador" id="id-d7876205ea795d41b522c619">
      <documentation>Gestiona usuarios, planes, trabajos y contenido en Django Admin.</documentation>
    </element>
    <element xsi:type="archimate:BusinessRole" name="Aprendiz del curso" id="id-9551cf5298e654c3af52a4aa"/>
    <element xsi:type="archimate:BusinessProcess" name="Subir clase (audio o texto)" id="id-58e35fdba39858249a449113"/>
    <element xsi:type="archimate:BusinessProcess" name="Practicar (sesión adaptativa)" id="id-6c27f69599a9557a860857b5"/>
    <element xsi:type="archimate:BusinessProcess" name="Repasar con repetición espaciada" id="id-a94f2c811fb95858b77210f4"/>
    <element xsi:type="archimate:BusinessProcess" name="Generar refuerzo dirigido" id="id-96f0ba98465d5b10a52a3278"/>
    <element xsi:type="archimate:BusinessProcess" name="Leer resumen de clase o curso" id="id-6e98abfedbd65415a405f9db"/>
    <element xsi:type="archimate:BusinessProcess" name="Seguir el plan de hoy" id="id-7bb8dde09e035f679aa63bd1"/>
    <element xsi:type="archimate:BusinessService" name="Acompañamiento adaptativo del estudio" id="id-8d42bf68b81358a9b2bd3e91"/>
    <element xsi:type="archimate:BusinessObject" name="Clase grabada" id="id-1ac9198588af53158bd53f70"/>
    <element xsi:type="archimate:BusinessObject" name="Ítem de evaluación" id="id-a9c1e32551bb5e33af432c7b"/>
    <element xsi:type="archimate:BusinessObject" name="Perfil de aprendizaje" id="id-6caa53d1930d5a78b8da3de9"/>
  </folder>
  <folder name="Application" id="id-8781742c8e2b5a57a8d91d8a" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="SIMA (aplicación web Django)" id="id-2cac7801e9d6567abff81e01"/>
    <element xsi:type="archimate:ApplicationComponent" name="Vistas por dominio" id="id-568ea666c23058d8bff6b743">
      <documentation>learning/views: core, courses, lessons, practice, study, summaries, pipeline.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Núcleo adaptativo" id="id-2c44832f4e25531b85883c82">
      <documentation>adaptive, psychometrics (IRT 3PL, EAP, randomesque, Elo, BKT), spaced_repetition (SM-2), segments, progress.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Pipeline de generación verificada" id="id-1b356ae1607350dd8da64302">
      <documentation>pipeline.py + parse_mini: transcripción → generación .mini → filtros → reparación → verificación factual → corrección → banco.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Servicios de IA" id="id-07f628b6e7185572aa1b2e04">
      <documentation>learning/services: prompts, backends (call_ai, proveedores), generation, repairs, evidence (web, EduQG), transcription (Whisper).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Cola de trabajos y worker" id="id-fa04d4b58068552d80556666">
      <documentation>job_queue (modo thread o db, límite por usuario) y comando run_worker.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Refuerzo y resúmenes" id="id-3ed94ed6d253522aa5c9a5cb">
      <documentation>adaptive_generation (ReinforcementJob) y summaries (SummaryJob).</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Créditos y planes" id="id-bbe0103ce1f2535a9a69db40">
      <documentation>credits: estimación, cobro y reembolso.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Proveedor de LLM (externo)" id="id-7ad38b71cc2e5f91b261a319">
      <documentation>API compatible con OpenAI: Qwen 3.8 y GPT-OSS vía Groq, DeepSeek; o Anthropic.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="Whisper (local)" id="id-e52232e645895f8fac9d6711">
      <documentation>Transcripción con segmentos y marcas de tiempo; el audio no sale del servidor.</documentation>
    </element>
    <element xsi:type="archimate:ApplicationService" name="Generación verificada de ítems" id="id-90bfbae5f6495284a89ee6bf"/>
    <element xsi:type="archimate:ApplicationService" name="Evaluación adaptativa por IRT" id="id-0056ba411d17579ab2320df4"/>
    <element xsi:type="archimate:ApplicationService" name="Refuerzo dirigido" id="id-22ac2098ef35525eb89d47d3"/>
    <element xsi:type="archimate:ApplicationService" name="Resúmenes de clase y curso" id="id-b0c0f41c5f635250818f0743"/>
    <element xsi:type="archimate:ApplicationService" name="Repaso espaciado y plan de estudio" id="id-2faacdd2f94055e2a2cb976c"/>
    <element xsi:type="archimate:ApplicationInterface" name="Interfaz web (HTTPS)" id="id-550a49c5a4b25d28b529d1fc"/>
    <element xsi:type="archimate:ApplicationInterface" name="Django Admin" id="id-2b2f6aec0f865530b2d3e51e"/>
    <element xsi:type="archimate:ApplicationInterface" name="/salud/ (monitoreo)" id="id-c8d00acc812755a0aa98cc3e"/>
    <element xsi:type="archimate:DataObject" name="Curso" id="id-77efe337bed550aca2de8a04"/>
    <element xsi:type="archimate:DataObject" name="Clase (LessonJob)" id="id-f355b35d1d30510a9f9f41c2">
      <documentation>Transcripción, .mini bruto y corregido, trazas del pipeline.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Transcripción y segmentos" id="id-e175ff67bce85b7eaeecdb61"/>
    <element xsi:type="archimate:DataObject" name="Banco de ítems .mini" id="id-05c88509376a55e18b1eca2a">
      <documentation>Question y AnswerOption con parámetros IRT, calibración y bandera de calidad.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Sesiones y respuestas" id="id-a98edb5214285fd5bb8a5a73">
      <documentation>PracticeSession y StudentAnswer (theta antes/después).</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Perfil adaptativo" id="id-a38d8fea9c9d5dd985567113">
      <documentation>AdaptiveProfile: theta, error estándar, dominio por tema y Bloom, vida media de retención.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Trabajos de refuerzo y resumen" id="id-75f9ada3bf895f8f8a31ff87">
      <documentation>ReinforcementJob y SummaryJob.</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Flashcards (SM-2)" id="id-e1e210a6bb2c516693631486"/>
    <element xsi:type="archimate:ApplicationComponent" name="Plantillas HTML, CSS y JS" id="id-2094c4e9490352cf8d6dafc5"><documentation>templates/learning y static/learning; hotkeys de práctica, tema claro/oscuro, SVG de progreso generado en servidor.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Transcripción con segmentos" id="id-2ba9713958a256fbb53ffb2a"><documentation>services/transcription + segments.py: Whisper con marcas de tiempo, TranscriptSegment, enlace pregunta↔segmento.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Repetición espaciada (SM-2)" id="id-5a6c1250fc995f468709d907"><documentation>spaced_repetition.py: EF≥1.3, intervalos 1→6→×EF, cola de repaso por curso.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Plan diario y progreso" id="id-9dd73bf46a1354fe84d8040a"><documentation>adaptive.daily_plan (reglas repasar/refuerzo/riesgo/examen), progress.py (serie de 14 días).</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Recordatorios por correo" id="id-02e61cd0679e5a09a4d4599b"><documentation>reminders.py + comando send_study_reminders (EMAIL_*, SIMA_SITE_URL).</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Portabilidad de cursos" id="id-7d7511bb2e275fb1973e40ff"><documentation>portability.py + comandos export_course / import_course (JSON).</documentation></element>
    <element xsi:type="archimate:DataObject" name="Resúmenes (Summary)" id="id-67239c93d8b854d280a8cde5"><documentation>Resumen de clase y de curso en formato t|/c|/p|/r|.</documentation></element>
    <element xsi:type="archimate:DataObject" name="Usuario, plan y créditos" id="id-6f4cb435a64e5ef3a3e07e3c"></element>
    <element xsi:type="archimate:ApplicationComponent" name="ORM de Django" id="id-8b6758efa5655248b1932679"><documentation>Modelos y migraciones sobre PostgreSQL (DB_ENGINE / DATABASE_URL).</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Cliente de LLM (API compatible con OpenAI)" id="id-e2f2316a8fdc57fdb1284e36"><documentation>services/backends: call_ai, modelo por rol, presupuesto de tokens, reintentos 429/413, limitador por minuto.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Parser .mini (parse_mini)" id="id-ab92dc4c233e563186ac50c8"><documentation>parse_mini: filtros de formato, reparación y conversión a ítems.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Envío de correo (SMTP)" id="id-075b5d7bd5d35380a4346801"><documentation>django.core.mail con EMAIL_HOST/EMAIL_PORT/TLS.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Archivos y registros" id="id-835c65832b705d0bbd7a4605"><documentation>Audios temporales, logs/sima.log rotativo, exportaciones CSV/JSON.</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Configuración" id="id-c597cc0c130c555789af4705"><documentation>sima/settings.py + .env (proveedor de LLM, cola, límites, correo, seguridad).</documentation></element>
    <element xsi:type="archimate:ApplicationComponent" name="Servidor SMTP (externo)" id="id-e3443e851fe4593991308a22"></element>
  </folder>
  <folder name="Technology &amp; Physical" id="id-c6f3d8e7c33954efbc50d780" type="technology">
    <element xsi:type="archimate:Node" name="Servidor de aplicación" id="id-37138183427f54f48db23e14"/>
    <element xsi:type="archimate:SystemSoftware" name="Python 3 + Django" id="id-12c5bb12b46e57e4bbfb76f3"/>
    <element xsi:type="archimate:SystemSoftware" name="PostgreSQL 18 (:5432)" id="id-714d93152ebb5c4a91a2be80"/>
    <element xsi:type="archimate:SystemSoftware" name="Whisper + ffmpeg" id="id-d1672c957f7c5e26813ed309"/>
    <element xsi:type="archimate:SystemSoftware" name="cron: send_study_reminders" id="id-258ef19fce8f55879611911d"/>
    <element xsi:type="archimate:Node" name="Proceso worker (run_worker)" id="id-a16c0e610deb5491b89ccd4a"/>
    <element xsi:type="archimate:Device" name="Dispositivo del estudiante" id="id-78b9f54e11235d98ae50cccb"/>
    <element xsi:type="archimate:Node" name="Nube del proveedor de LLM" id="id-e0fa006c08125a768f3cd6b7"/>
    <element xsi:type="archimate:CommunicationNetwork" name="Internet (HTTPS / TLS 1.3)" id="id-79d427f27170563593e29412"/>
    <element xsi:type="archimate:TechnologyService" name="Servicio web HTTPS" id="id-f8fa92ca3adc55f381ac2e9e"/>
    <element xsi:type="archimate:TechnologyService" name="Servicio de base de datos" id="id-ae619e36c75355f2ad8a9303"/>
    <element xsi:type="archimate:TechnologyService" name="API de chat completions" id="id-a5aba7ed64725dce88ed7df8"/>
    <element xsi:type="archimate:Artifact" name="Código de SIMAApp" id="id-cd685f7f79e9503894e37686"/>
    <element xsi:type="archimate:Artifact" name="logs/sima.log (rotativo)" id="id-7b85ac8075b359cfa44e2598"/>
    <element xsi:type="archimate:Artifact" name="Audios subidos (temporales)" id="id-11cb7e61a5445ff7b1bc1099"/>
    <element xsi:type="archimate:Artifact" name=".env (configuración)" id="id-189c7c1ac6955c929b4671b6"/>
    <element xsi:type="archimate:SystemSoftware" name="Navegador web" id="id-c22674edb4ad53c28e3c6ddd"><documentation>Chrome, Edge, Firefox o Safari; sin instalación en el cliente.</documentation></element>
    <element xsi:type="archimate:Node" name="DNS y certificado TLS (Cloudflare)" id="id-4060beefdd0b5cc19d4a6b71"><documentation>Dominio público (SIMA_PUBLIC_HOST), certificado y protección básica; opcional.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Nginx (proxy inverso :443)" id="id-87c4047aa88a5757a63fc8b5"><documentation>Termina TLS, sirve estáticos y reenvía a Gunicorn.</documentation></element>
    <element xsi:type="archimate:SystemSoftware" name="Gunicorn + Django (WSGI :8000)" id="id-927b74793f84530b9cc5baed"><documentation>Aplicación SIMA; varios workers WSGI.</documentation></element>
    <element xsi:type="archimate:Node" name="Servidor de base de datos" id="id-47af9faf99f95e86afe0db8d"><documentation>Azure Database for PostgreSQL (subred privada) o PostgreSQL en el mismo servidor.</documentation></element>
    <element xsi:type="archimate:Artifact" name="Archivos estáticos" id="id-d8f2cd63659d50158a54e81f"><documentation>collectstatic: CSS, JS, imágenes.</documentation></element>
    <element xsi:type="archimate:Node" name="Servidor SMTP" id="id-43855cf1c14e50259216069c"><documentation>Proveedor de correo para los recordatorios de estudio.</documentation></element>
    <element xsi:type="archimate:TechnologyService" name="Servicio de correo" id="id-09682bddb433550a91df55bc"></element>
  </folder>
