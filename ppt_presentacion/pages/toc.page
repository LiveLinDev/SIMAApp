pageType: table_of_contents
background:
  type: solid
  color: "$background"
elements:
  - elementId: toc-label
    elementType: text
    bounds: [60, 50, 400, 30]
    content:
      fontFamily: "Liter"
      fontSize: 14
      color: "$secondary"
      align: [left, middle]
      wrap: false
      letterSpacing: 2
      text: |
        <p>AGENDA</p>
  - elementId: toc-accent
    elementType: shape
    bounds: [60, 90, 60, 4]
    shapeName: rect
    fill:
      type: solid
      color: "$accent"
  - elementId: toc-title
    elementType: text
    bounds: [60, 110, 400, 70]
    content:
      style: "$subtitle"
      fontSize: 40
      align: [left, middle]
      wrap: false
      text: |
        <p>Contenido</p>
  - elementId: toc-card-1
    elementType: shape
    bounds: [60, 210, 360, 90]
    shapeName: roundRect
    adjustments: [16000]
    fill:
      type: solid
      color: "$cardBg"
    shadow:
      blur: 12
      color: "#00000012"
      offset: [0, 4]
  - elementId: toc-num-1
    elementType: text
    bounds: [80, 225, 60, 60]
    content:
      fontFamily: "Liter"
      fontSize: 36
      color: "$accent"
      align: [left, middle]
      wrap: false
      text: |
        <p>01</p>
  - elementId: toc-text-1
    elementType: text
    bounds: [150, 225, 250, 60]
    content:
      fontFamily: "QuattrocentoSans"
      fontSize: 18
      color: "$primary"
      align: [left, middle]
      lineHeight: 1.3
      text: |
        <p><strong>Contexto y Problemática</strong></p>
        <p><span style="font-size:14px; color:$secondary;">El gap entre clase y repaso</span></p>
  - elementId: toc-card-2
