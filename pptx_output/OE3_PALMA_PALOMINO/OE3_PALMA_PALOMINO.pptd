title: OE3 – Desarrollo e Implementación de SIMA
size: [1280, 720]
theme:
  colors:
    primary: "#0F2B46"
    secondary: "#6B7B8C"
    accent: "#0D9488"
    background: "#F8F9FA"
    text: "#1A1A2E"
    cardBg: "#FFFFFF"
    lightGray: "#F1F5F9"
    borderGray: "#E5E7EB"
    white: "#FFFFFF"
  textStyles:
    title:
      fontSize: 40
      color: "$white"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.2
    subtitle:
      fontSize: 20
      color: "$secondary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.3
    heading:
      fontSize: 28
      color: "$primary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.2
    body:
      fontSize: 18
      color: "$text"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.5
    caption:
      fontSize: 14
      color: "$secondary"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.3
    navText:
      fontSize: 14
      color: "$white"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.2
  tableStyles:
    default:
      fontSize: 16
      fontFamily: "QuattrocentoSans"
      headerFill: "$primary"
      headerColor: "$white"
      headerBold: true
      bodyFill:
        - "$cardBg"
        - "$lightGray"
      bodyColor: "$text"
      border:
        style: solid
        width: 1
        color: "$borderGray"
pages:
  - pages/cover.page
  - pages/agenda.page
  - pages/intro_oe3.page
  - pages/stack_tecnologico.page
  - pages/epicas.page
  - pages/hu_ingesta.page
  - pages/hu_generacion.page
  - pages/pipeline.page
  - pages/vista_dashboard.page
  - pages/vista_cursos.page
  - pages/vista_pipeline.page
  - pages/vista_microcontenidos.page
  - pages/vista_quiz.page
  - pages/vista_resultados.page
  - pages/arquitectura.page
  - pages/irt_3pl.page
  - pages/futuro_validacion.page
  - pages/conclusiones.page
